# Copy to .env and fill in. .env is git-ignored.
POSTGRES_DB=amazon
POSTGRES_USER=amazon
POSTGRES_PASSWORD=change-me

# openssl rand -base64 64 | tr -d '\n'
APP_JWT_SECRET=

