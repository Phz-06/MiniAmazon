# Copy to .env and fill in. .env is git-ignored.
POSTGRES_DB=amazon
POSTGRES_USER=amazon
POSTGRES_PASSWORD=change-me

# openssl rand -base64 64 | tr -d '\n'
APP_JWT_SECRET=

APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me
APP_ADMIN_EMAIL=admin@example.com

# 0 = world never drops a message, 99 = drops almost everything
WORLD_FLAKINESS=0
# 0 keeps the simulator's own speed; higher makes packing and driving faster
WORLD_SIM_SPEED=0
# Size of the carrier's fleet
CARRIER_TRUCKS=10
# JVM options for world-gateway and carrier-service, and for order-service.
# The defaults keep the whole stack around 2 GB; raise the heaps for load tests.
#SERVICE_JAVA_OPTS=-Xmx192m -XX:+UseSerialGC -Xss512k
#ORDER_SERVICE_JAVA_OPTS=-Xmx320m -XX:+UseSerialGC -Xss512k
